FLASK_APP=run.py
FLASK_ENV=development
# Optional direct override: DEBUG, INFO, WARNING, ERROR, CRITICAL
# LOG_LEVEL=DEBUG

# Generate strong secrets via: python3 -c "import secrets; print(secrets.token_hex(32))"
SECRET_KEY=dev-secret-key-change-in-production
JWT_SECRET_KEY=dev-jwt-secret-key-change-in-production

# Allowed CORS origins (comma-separated origins or * for development)
CORS_ALLOWED_ORIGINS=http://localhost:3000,http://localhost:5173,http://localhost:8080

DATABASE_URL=postgresql://postgres:postgres@localhost:5432/revoshop_db
 
# Locust Load Testing Configuration
LOCUST_HOST=http://127.0.0.1:5000
# Set to 'true' to run automatic gradual ramp stages (50 -> 100 -> 200 users)
# Set to 'false' (or leave commented) to manually enter users and spawn rate in Web UI
LOCUST_USE_LOAD_SHAPE=false
# Supabase Storage Configuration
SUPABASE_URL=https://shgafjqeprksdawepfcl.supabase.co
SUPABASE_KEY=your-supabase-anon-or-service-role-key-here
SUPABASE_BUCKET=products
